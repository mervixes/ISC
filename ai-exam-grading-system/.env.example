# Required. On Supabase use the SESSION POOLER string (port 5432 on the pooler host).
# See DEPLOYMENT.md before choosing between the session and transaction pooler.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optional. Connections each serverless instance may hold. Keep it small on serverless.
PG_POOL_MAX=3

# Optional AI keys. If these are set the app can mark papers before you add a key in the UI.
# Only one is needed; the ones you save in the app are tried first.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional. Pins the model instead of choosing the provider's current recommendation.
# AI_MODEL=
